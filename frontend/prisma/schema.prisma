generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash    String?
  emailVerifiedAt DateTime?
  tokenVersion    Int       @default(0)
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name            String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl       String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role            String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  verificationCodes VerificationCode[]
  uploads           FileUpload[]
  notifications     Notification[]
  notifPrefs        NotificationPreferences?
  pushSubscriptions PushSubscription[]
  orders            Order[]
  oauthAccounts     OAuthAccount[]
  adminActions      AdminAction[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "user.role_change", "order.refund", "shop.plan_grant").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  ownerId   String
  owner     User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  // Tamani lot 3: an Organization is a wholesaler's shop.
  whatsappPhone         String? // E.164
  country               String  @default("SN") // ISO-2, default region for local phone numbers
  currency              String  @default("XOF")
  logoUrl               String?
  description           String? // shown in the popup (lot 5b), 300 characters at most
  coefConsumer          Float   @default(0.5) // share of announced consumer demand that turns real
  coefReseller          Float   @default(0.7)
  // Lot 6: on the free plan, the one campaign whose verdict is offered (the
  // first to reach 20 counted answers), reserved once by free-verdict.ts.
  freeVerdictCampaignId String?

  zones        DeliveryZone[]
  products     Product[]
  campaigns    Campaign[]
  respondents  Respondent[]
  responses    Response[]
  subscription Subscription?

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
// Tamani lot 5: one row per browser that accepted Web Push notifications.
// An endpoint the push service answers 404/410 for is deleted.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id            String  @id @default(cuid())
  userId        String? // nullable — guest checkout supported
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Int // gross amount, smallest unit
  currency      String  @default("XOF") // ISO 4217
  status        String  @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail String?
  customerPhone String?
  customerName  String?
  metadata      Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey String? @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

// ───────────────────────────────────────────────────────────────────────
// Tamani core (lot 3, migration 6_tamani_core). Amounts are integer FCFA;
// statuses are Strings, never Prisma enums. Every row carries its shop
// (organizationId) so routes can scope every query to one shop.
// ───────────────────────────────────────────────────────────────────────

model DeliveryZone {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int          @default(0)
  responses      Response[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
}

model Product {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  unitLabel       String       @default("pièce")
  unitPrice       Int
  wholesalePrice  Int?
  wholesaleMinQty Int?
  costPrice       Int? // purchase price: never exposed to respondents
  photos          Json         @default("[]") // Cloudinary URLs
  optionLabel     String? // e.g. "Couleur"
  options         String[]     @default([])
  archivedAt      DateTime?
  campaigns       Campaign[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, createdAt])
}

// The status stored here is the wholesaler's last action; the effective
// status (an ACTIVE campaign past endsAt reads CLOSED) is computed at read
// time by lib/server/tamani/campaign-status.ts.
model Campaign {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId       String
  // NoAction: a product with campaigns is archived, never deleted, while
  // deleting the whole shop still cascades.
  product         Product        @relation(fields: [productId], references: [id], onDelete: NoAction)
  title           String
  availability    String // IN_STOCK | INCOMING
  availableAt     DateTime?
  stockQuantity   Int?
  plannedQuantity Int? // what the wholesaler plans to order: the verdict's reference
  showStock       Boolean        @default(false)
  endsAt          DateTime?
  deliveryEnabled Boolean        @default(false)
  showLiveCounter Boolean        @default(true)
  shareTemplate   String
  status          String         @default("DRAFT") // DRAFT | ACTIVE | CLOSED | ARRIVED
  closedAt        DateTime?
  arrivedAt       DateTime?
  links           CampaignLink[]
  responses       Response[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([productId])
}

model CampaignLink {
  id         String     @id @default(cuid())
  campaignId String
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  code       String     @unique // base62, 7 chars: /c/[code]
  label      String
  isDefault  Boolean    @default(false)
  openCount  Int        @default(0)
  responses  Response[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([campaignId])
}

// A "client" in the UI. Scoped to one shop: the same number at two shops
// is two respondents. Postgres allows many NULL phoneE164 (anonymized rows)
// under the unique key.
model Respondent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneE164      String?
  firstName      String?
  notes          String?
  firstSeenAt    DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  anonymizedAt   DateTime?
  responses      Response[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, phoneE164])
}

model Response {
  id                  String        @id @default(cuid())
  campaignId          String
  campaign            Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organizationId      String // denormalized from the campaign: monthly quota and filters
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  linkId              String?
  link                CampaignLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  respondentId        String?
  respondent          Respondent?   @relation(fields: [respondentId], references: [id], onDelete: SetNull)
  deviceId            String
  interested          Boolean?
  notInterestedReason String? // TOO_EXPENSIVE | NO_NEED | ALREADY_BOUGHT | OTHER
  buyerType           String? // CONSUMER | RESELLER
  quantity            Int?
  option              String?
  timing              String?
  wantsDelivery       Boolean?
  zoneId              String?
  zone                DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  completedAt         DateTime?
  locked              Boolean       @default(false) // over the monthly quota: kept, hidden until upgrade
  suspicious          Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([campaignId, deviceId])
  @@unique([campaignId, respondentId])
  @@index([organizationId, completedAt])
  @@index([campaignId, completedAt])
  @@index([respondentId])
}

model Subscription {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan             String       @default("FREE") // FREE | PRO | BUSINESS
  currentPeriodEnd DateTime?
  graceUntil       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}
